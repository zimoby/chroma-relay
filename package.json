{
  "name": "com.zimoby.chroma-relay",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "watch": "tsc && vite build --watch true",
    "build": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && vite build --watch false && node --input-type=module -e \"import('./scripts/run-live-ae-tests.mjs').then(({ writeBuildProvenance }) => writeBuildProvenance())\"",
    "build:dev": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env VITE_CHROMA_RELAY_DEBUG=true vite build --mode development --watch false",
    "cdp:inspect": "node scripts/cep-cdp.mjs inspect",
    "cdp:settings": "node scripts/cep-cdp.mjs settings-smoke",
    "cdp:design": "node scripts/cep-design-capture.mjs",
    "cdp:self-test": "node scripts/cep-cdp.mjs self-test",
    "cdp:persistence": "node scripts/cep-persistence-smoke.mjs",
    "cdp:palette-management": "node scripts/cep-palette-management-smoke.mjs",
    "cdp:collect": "node scripts/cep-functional-smoke.mjs --mode=collect",
    "cdp:native-gradient:collect": "node scripts/cep-native-gradient-collect-smoke.mjs",
    "cdp:native-gradient:apply": "node scripts/run-live-ae-tests.mjs",
    "cdp:apply": "node scripts/cep-functional-smoke.mjs --mode=apply",
    "cdp:image": "node scripts/cep-functional-smoke.mjs --mode=image",
    "cdp:image-selection": "node scripts/cep-functional-smoke.mjs --mode=image-selection",
    "cdp:mutate": "node scripts/cep-functional-smoke.mjs --mode=mutate",
    "test:domain": "node --experimental-strip-types --test tests/palette-domain.test.ts tests/palette-transfer.test.ts tests/color-format.test.ts tests/layout-settings-domain.test.ts tests/image-palette-domain.test.ts tests/gradient-slot-domain.test.ts",
    "test:storage": "node --experimental-strip-types --test tests/palette-storage.test.ts tests/layout-settings-storage.test.ts tests/image-palette-file.test.ts",
    "test:live-runner": "node --test tests/live-runner.test.mjs",
    "test:runner-contract": "node --experimental-strip-types --test tests/product-contract.test.mjs tests/live-runner-contract.test.mjs && node --test tests/live-runner.test.mjs",
    "test:release-contract": "node --test tests/release-contract.test.mjs",
    "verify:static": "npm run build && npm run test:domain && npm run test:storage && npm run test:host-contract && npm run test:native-gradient && npm run test:runner-contract && npm run test:release-contract && npm run check:cep",
    "test:host-contract": "node --test tests/host-contract.test.mjs",
    "test:native-gradient": "node --experimental-strip-types --test tests/native-gradient-package-integration.test.ts tests/native-gradient-collection.test.ts tests/native-gradient-application.test.ts",
    "inspect:native-gradient": "ae-native-gradient inspect",
    "check:cep": "node scripts/check-cep-compat.mjs",
    "cleanup:live-test-residue": "node scripts/cleanup-live-test-residue.mjs",
    "react:doctor": "node scripts/run-react-doctor.mjs",
    "package:alpha": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ALPHA_PACKAGE=true vite build --watch false && node scripts/package-alpha.mjs",
    "zxp": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZXP_PACKAGE=true vite build --watch false && npm run check:cep",
    "zip": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZIP_PACKAGE=true vite build --watch false",
    "serve": "cross-env SERVE_PANEL=true vite preview",
    "symlink": "cross-env BOLT_ACTION=symlink vite",
    "delsymlink": "cross-env BOLT_ACTION=delsymlink vite"
  },
  "dependencies": {
    "@zimoby/ae-native-gradient": "git+https://github.com/zimoby/ae-native-gradient-toolkit.git#04144bea5f16e8b2dc2355b72f315f810c3f97e1",
    "image-q": "4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.0",
    "@babel/plugin-proposal-class-properties": "^7.16.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.16.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.16.4",
    "@babel/preset-env": "^7.19.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.16.0",
    "@babel/runtime": "^7.16.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^16.11.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/trusted-types": "^2.0.2",
    "@vitejs/plugin-react": "^4.5.1",
    "babel-plugin-react-require": "^4.0.3",
    "babel-plugin-transform-scss": "^1.2.0",
    "babel-preset-env": "^1.7.0",
    "core-js": "3",
    "cross-env": "^7.0.3",
    "fs-extra": "^10.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.42.0",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-node-copy": "^1.0.4",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.89.1",
    "source-map": "^0.7.4",
    "types-for-adobe": "^7.2.3",
    "types-for-adobe-extras": "^0.0.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-cep-plugin": "^2.2.3",
    "ws": "^8.21.1"
  }
}
